# EcoMetric Web Dashboard – biến môi trường cho Vite
# Sao chép file này thành `.env.local` rồi chỉnh theo môi trường của bạn.
# Vite chỉ expose các biến có tiền tố VITE_ ra phía client.

# Base URL của Backend FastAPI (service layer: src/services/api.js)
VITE_API_BASE_URL=http://localhost:8000

# Thời gian chờ tối đa cho một request (ms). Mặc định 15000.
VITE_API_TIMEOUT_MS=15000
